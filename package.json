{
  "name": "mybox",
  "version": "0.0.1",
  "author": "Lucas Gomes",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "generate:images": "npx capacitor-assets generate --android",
    "dev:android": " ionic capacitor run android -l --external"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ionicons": "^8.1.0",
    "ngx-sonner": "^3.1.0",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config",
  "description": "An Ionic project"
}
